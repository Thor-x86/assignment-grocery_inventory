{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"overrides": [
		{
			"files": ["*.yml", "*.yaml", "*.md"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	],
	"ignorePatterns": ["pnpm-lock.yaml", "package-lock.json", "yarn.lock", "Cargo.lock"]
}